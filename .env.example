# ShoppingSync settings template. Safe to commit: it holds no values.
# Make your private copy with:   cp .env.example .env.local
# then paste each value after the = sign in .env.local (no spaces or quotes).

# Supabase > Project Settings > API keys / Data API
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" (or "anon public") key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" (or "service_role") key. Server use only; never share it.
SUPABASE_SECRET_KEY=

# Optional: only used once, to link a family set up before multi-group to its WhatsApp group
WHATSAPP_GROUP_NAME=

# Where family phones can open the console (used in the private setup link the bot sends).
# localhost only works on this Mac; use your Mac's Wi-Fi address (http://192.168.x.x:3000) or the Vercel URL.
PUBLIC_BASE_URL=http://localhost:3000

# Local AI (Ollama on this Mac). Run "ollama list" to see installed model names.
OLLAMA_MODEL=qwen2.5:14b

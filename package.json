{
  "name": "shoppingsync",
  "version": "0.1.0",
  "private": true,
  "description": "Family shopping list fed by a WhatsApp group, sorted by shop.",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
